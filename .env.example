# --- Required ---------------------------------------------------------------

# Mealie as seen from the Forager container. If Mealie runs in the same
# compose project, use its service name, e.g. http://mealie:9000
MEALIE_URL=http://mealie:9000
# Mealie → your profile → API Tokens → Generate
MEALIE_API_KEY=
# https://platform.openai.com/api-keys (or a key for OPENAI_URL below)
OPENAI_API_KEY=

# Password for the web UI (any username). Leave empty only if a reverse proxy
# in front of Forager already requires a login.
AUTH_PASSWORD=

# --- Optional ---------------------------------------------------------------

# The Mealie URL you open in a browser, used for links in the UI.
# MEALIE_PUBLIC_URL=https://mealie.example.com
# MEALIE_GROUP_NAME=home

# Any OpenAI-compatible API.
# OPENAI_URL=https://api.openai.com/v1
# TEXT_MODEL=gpt-5-mini
# TRANSCRIPTION_MODEL=whisper-1
# CLEAN_MODEL=
# EXTRA_PROMPT=Use metric units.

# CLEANUP=true
# CLEAN_TAG=Imported Clean
# WORKERS=2
# MAX_DURATION_SECS=1800
# MAX_UPLOAD_MB=100
# Netscape cookie jar for yt-dlp/gallery-dl (mount it into the container).
# COOKIES_FILE=/data/cookies.txt
